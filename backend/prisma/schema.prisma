// Eventick — PostgreSQL schema (Prisma)
// Money is stored as INTEGER CENTS (Int) everywhere — never floating point.
// All public content is bilingual: every FR field has an AR sibling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}

/// How a venue is laid out, for drawing the site plan.
///
/// Six shapes rather than a free drawing tool: an organiser filling in one
/// field gets an honest plan, where a canvas editor would get skipped and
/// leave the event with none at all. Each one is a genuinely different
/// arrangement, not a label on the same picture.
enum VenueKind {
  /// Everything faces one stage: concerts, festivals, club nights.
  STAGE
  /// Seated room facing a stage, usually numbered: theatre, comedy, opera.
  HALL
  /// Tiers wrapping a pitch or floor on several sides.
  STADIUM
  /// A route rather than a room — marathons, rallies, street events. Zones
  /// are start waves or distances, not places to stand.
  COURSE
  /// Halls of stands, walked rather than watched: salons, trade fairs.
  EXPO
  /// Open ground with no fixed front: beaches, gardens, ramparts.
  OPEN_AIR
}

enum EventStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  /// Money returned to the buyer. Distinct from CANCELLED, which only voids
  /// tickets and releases stock without moving any money.
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  TRANSFERRED
}

enum PromoKind {
  PERCENT
  AMOUNT
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  /// Where to reach this person about an order. Collected at sign-up and
  /// reused at every checkout, so a buyer is not asked for it again on each
  /// purchase -- the account already knows.
  ///
  /// NULLABLE, and that is deliberate. Accounts created before this column
  /// existed have no number, and a required field cannot be applied
  /// backwards without inventing data. New sign-ups must provide one; the
  /// older accounts are asked once, at their next checkout, and it is saved
  /// to the account from there.
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  /// Commission plan, for organisers. Null for customers, and for an
  /// organiser nobody has assigned one to yet — the finance routes fall back
  /// to the default plan rather than charging nothing.
  planId String? @map("plan_id")

  events   Event[]
  orders   Order[]
  listings ResaleListing[]
  shares   TicketShare[]
  upgrades TicketUpgrade[]
  /// Tickets held without having bought them — a share claimed from someone
  /// else's order. Named, because Ticket reaches User twice (buyer via order,
  /// holder directly).
  heldTickets Ticket[] @relation("TicketHolder")

  plan          Plan?                @relation(fields: [planId], references: [key], onDelete: SetNull)
  bankAccount   BankAccount?
  payouts       Payout[]
  subscriptions SubscriptionCharge[]
  auditEvents   AuditEvent[]
  invitations   Invitation[]

  /// Applications this person submitted to become an organiser.
  organiserApplications OrganiserApplication[] @relation("OrganiserApplicant")
  /// Plan changes this organiser has asked for.
  planRequests          PlanRequest[]          @relation("PlanRequester")
  /// Plan requests this person decided, as an admin.
  reviewedPlanRequests  PlanRequest[]          @relation("PlanReviewer")
  /// Applications this person decided, as an admin.
  reviewedApplications  OrganiserApplication[] @relation("OrganiserReviewer")

  /// Store credit. An append-only ledger, not a running total — see
  /// CreditEntry for why there is no balance column here.
  creditEntries CreditEntry[] @relation("CreditHolder")
  /// Credit entries this person granted or adjusted, as staff.
  grantedCredit CreditEntry[] @relation("CreditActor")

  /// Outstanding password-reset requests.
  passwordResets PasswordReset[]

  @@map("users")
}

/// A pending "I forgot my password" request.
///
/// There was no way to recover an account at all: no route, no email, no
/// link on the login page. A buyer who forgot their password could not buy,
/// and at the checkout they hit that wall with a hold counting down.
///
/// What is stored is the SHA-256 of the token, never the token itself. The
/// emailed link is the only copy, exactly as a password hash works and for
/// the same reason: a leaked database should not hand over working reset
/// links for every account that has one outstanding.
model PasswordReset {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// SHA-256 of the emailed token, hex. Unique so a lookup is one indexed
  /// read, and so two requests cannot collide on the same secret.
  tokenHash String @unique @map("token_hash")

  /// Short-lived on purpose: a reset link is a password equivalent, and the
  /// person asking for it is reading their email right now.
  expiresAt DateTime  @map("expires_at")
  /// Set the moment it is spent. Single use — a link that still worked after
  /// the password changed would be a second key left under the mat, and the
  /// inbox it sits in may be shared, forwarded or later compromised.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Expiry sweeps and "does this account have a pending request" both scan
  /// by user, so index it.
  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Permissions
//
// A user still has exactly ONE role (User.role above). What a role may DO is
// data, not code: RolePermission rows. Adding a capability to organisers is
// an INSERT, not a deploy.
//
// Deliberately NOT modelled:
//   - per-user permission overrides. One role per user, permissions per role.
//     A user needing a different set needs a different role.
//   - row ownership. "Which rows may I touch" stays an ownership check in the
//     route (event.organiserId === user.id). Permissions answer "may I do
//     this kind of thing at all", never "to whose data" — conflating the two
//     is how one organiser ends up able to edit another's events.
// ---------------------------------------------------------------------------

model Permission {
  /// The permission string itself is the primary key (e.g. "events.manage").
  /// Not a cuid: the key is already unique, stable, and human-readable, and a
  /// surrogate id would let a re-seed mint a new id and orphan every
  /// RolePermission row pointing at the old one.
  key         String   @id
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(cuid())
  role          Role
  permissionKey String     @map("permission_key")
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  /// Makes seeding idempotent: upsert needs a unique to target, and without
  /// this every re-seed would duplicate the grant rows.
  @@unique([role, permissionKey])
  /// Authorisation reads this by role on (nearly) every authenticated
  /// request, so it gets its own index.
  @@index([role])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  // Nullable only so an event survives its organiser's account being
  // removed (onDelete: SetNull below). It is NOT a "is this a demo event"
  // flag — the seed gives every event an organiser, so null means "the
  // owner's account is gone", nothing more. See seoIndexable for that.
  organiserId String?     @map("organiser_id")
  status      EventStatus @default(PUBLISHED)

  titleFr  String @map("title_fr")
  titleAr  String @map("title_ar")
  category String
  city     String

  venueFr String @map("venue_fr")
  venueAr String @map("venue_ar")
  address String

  /// What SHAPE the venue is, which decides how the site plan is drawn.
  ///
  /// The plan used to be three hardcoded shapes — a stage, a VIP wedge and a
  /// lawn — identical on every event. A marathon was shown a VIP zone it has
  /// no concept of, a numbered theatre was shown a lawn, and an event with
  /// two zones still got three blocks. It described one venue and was wrong
  /// about every other.
  ///
  /// Deliberately NOT inferred from `category`: a culture event can be in a
  /// box theatre or a Roman amphitheatre, and those are not the same room.
  /// The organiser knows which; nobody else does.
  ///
  /// STAGE is the default because it is the old hardcoded arrangement, so
  /// every existing event keeps exactly the plan it had until someone says
  /// otherwise.
  venueKind VenueKind @default(STAGE) @map("venue_kind")

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")
  doorsAt DateTime @map("doors_at")

  image      String
  badge      String?
  blurbFr    String  @map("blurb_fr")
  blurbAr    String  @map("blurb_ar")
  aboutFr    String  @map("about_fr")
  aboutAr    String  @map("about_ar")
  ageFr      String  @map("age_fr")
  ageAr      String  @map("age_ar")
  popularity Int     @default(0)
  instant    Boolean @default(true) // sold instantly vs waitlist-only when sold out

  /// DEAD — buyer self-cancellation was removed when tickets became final
  /// sale, so nothing reads this. Kept because dropping the column would
  /// destroy rows to no purpose; delete it if the policy never comes back.
  cancelCutoffHours Int @default(48) @map("cancel_cutoff_hours")

  /// Tickets ONE BUYER may hold for this event, across every order they
  /// place. Distinct from the per-order cap (MAX_QTY_PER_TIER, 8): that one
  /// only limits a single request, so one email could buy 8 three times over
  /// and take 24 seats of a high-demand show. This is the limit that actually
  /// keeps tickets with fans rather than resellers.
  ///
  /// 0 means unlimited, for an event where hoarding is not a concern.
  maxPerBuyer Int @default(10) @map("max_per_buyer")

  /// When the organiser called the event off, and why.
  ///
  /// Separate from `status: CANCELLED` so the reason survives for the buyers
  /// who have to be told — a status alone cannot answer "why was my festival
  /// cancelled", which is the first thing anyone asks.
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  /// May buyers resell their tickets for this event?
  ///
  /// Opt-in, and off by default. Resale is a secondary market: useful when an
  /// organiser wants it, but making every event a reseller venue by default
  /// is a decision the organiser should take, not the platform.
  allowResale Boolean @default(false) @map("allow_resale")

  /// Is this a real, bookable event — or demo/seed data?
  ///
  /// Only ever used to decide whether the public page may carry schema.org
  /// Event markup. Google's structured-data policy treats markup describing
  /// events that cannot actually be booked as spam, and the penalty lands on
  /// the whole domain rather than the one page.
  ///
  /// It has to be its own column. `organiserId` cannot stand in for it, even
  /// though the comment above still reads "null for seeded/platform events":
  /// the seed assigns every event an organiser, so that field marks all 16
  /// demo rows as genuine. Gating on it would publish fabricated prices as
  /// real inventory — the exact thing the policy forbids.
  ///
  /// Defaults to FALSE, so a new event is never marked up until someone says
  /// it is real. Failing closed is the only safe default here.
  seoIndexable Boolean @default(false) @map("seo_indexable")

  createdAt DateTime @default(now()) @map("created_at")

  organiser   User?           @relation(fields: [organiserId], references: [id], onDelete: SetNull)
  tiers       TicketTier[]
  lineup      LineupItem[]
  orders      Order[]
  promoCodes  PromoCode[]
  waitlist    WaitlistEntry[]
  invitations Invitation[]

  @@index([organiserId])
  @@index([status])
  @@map("events")
}

model LineupItem {
  id      String   @id @default(cuid())
  eventId String   @map("event_id")
  day     DateTime
  time    String
  name    String
  genreFr String   @map("genre_fr")
  genreAr String   @map("genre_ar")
  image   String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("lineup_items")
}

model TicketTier {
  id      String @id @default(cuid())
  eventId String @map("event_id")

  nameFr  String @map("name_fr")
  nameAr  String @map("name_ar")
  blurbFr String @map("blurb_fr")
  blurbAr String @map("blurb_ar")

  priceCents  Int      @map("price_cents")
  capacity    Int
  numbered    Boolean  @default(false) // true -> tickets get a row/seat on purchase
  /// Seats per row when `numbered`. Was hardcoded to 12, which only matched
  /// one imaginary venue; a real room has its own row width.
  seatsPerRow Int      @default(12) @map("seats_per_row")
  recommended Boolean  @default(false)
  saveCents   Int?     @map("save_cents") // displayed "you save X" vs buying tiers separately
  perks       String[] @default([]) // e.g. "qr", "lounge", "skip" — drives the VIP/perk filter on Explorer

  zoneFr String @map("zone_fr")
  zoneAr String @map("zone_ar")
  gateFr String @map("gate_fr")
  gateAr String @map("gate_ar")

  /// Whether this tier is a PLACE, and so belongs on the site plan.
  ///
  /// Not every tier is somewhere to stand. "Pass 3 jours" and "Pass journée"
  /// admit you to the same ground on different days; "Semi-marathon" and
  /// "Marathon 42 km" are distances; "Badge visiteur" is a credential. The
  /// plan drew all of them as stacked zones, which told a buyer the 3-day
  /// pass stands nearer the stage than the day pass. It does not — that was
  /// invented geography, and it was wrong on six of sixteen events.
  ///
  /// False means the tier still sells exactly as before; it simply is not
  /// drawn, and is listed under the plan as an admission type instead.
  ///
  /// Default true, because the majority of tiers ARE places (a balcony, a
  /// pit, a stand) and because it keeps every existing tier drawn exactly as
  /// it was until somebody says otherwise.
  spatial Boolean @default(true)

  /// Where this zone sits on the plan: 0 is nearest the action, counting
  /// back. Null means "no opinion", and those fall back to price order.
  ///
  /// Price was the only ordering before, and it is a decent proxy that is
  /// wrong exactly where it matters. Mawazine's "Pass VIP Front Stage" is
  /// both the dearest and the nearest, so price got it right by luck; a
  /// cheap side balcony close to the stage, or a premium rear lounge, come
  /// out backwards. The organiser is the only one who knows the room.
  ///
  /// Ties are broken by price, so filling this in for some zones and not
  /// others still produces a sensible drawing rather than an arbitrary one.
  planOrder Int? @map("plan_order")

  /// When this tier may be bought. Both null means "on sale as soon as the
  /// event is published", which is how every tier behaved before these
  /// existed.
  ///
  /// This is what early-bird pricing, staged releases and "doors close at
  /// midnight" are made of — an organiser plans a launch around exactly these
  /// two timestamps, and without them every tier goes live at once.
  salesStartAt DateTime? @map("sales_start_at")
  salesEndAt   DateTime? @map("sales_end_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderLines  OrderLine[]
  tickets     Ticket[]
  /// Upgrades moving INTO this zone. Named because the upgrade's own
  /// fromTierId is a plain column, not a relation.
  upgradesIn  TicketUpgrade[] @relation("UpgradeTarget")
  invitations Invitation[]

  @@index([eventId])
  @@map("ticket_tiers")
}

// ---------------------------------------------------------------------------
// Orders & tickets
// ---------------------------------------------------------------------------

/// An order holds inventory for `holdUntil` before payment is confirmed. The
/// checkout transaction re-checks `holdUntil` and remaining stock atomically —
/// see domain/inventory.ts — so two concurrent buyers can't both win the last
/// seat the way the old client-only Zustand store allowed.
model Order {
  id         String      @id @default(cuid())
  customerId String?     @map("customer_id") // null = guest checkout
  eventId    String      @map("event_id")
  status     OrderStatus @default(PENDING)

  /// Proof of purchase for a buyer who has no account.
  ///
  /// A guest order has no customerId, so there is no user to authorise a
  /// request against — and the id alone cannot stand in for one, because
  /// cuid() embeds a timestamp and counter and was never meant to be secret.
  /// This is: randomBytes(24), handed to the buyer as the `k` parameter of
  /// their confirmation link, and required for anything that reads personal
  /// data or changes a ticket.
  ///
  /// Set for EVERY order, not just guest ones, so a registered buyer can also
  /// use their emailed link without logging in first.
  accessToken String? @unique @map("access_token")

  holderName String @map("holder_name")
  email      String
  phone      String

  subtotalCents Int @map("subtotal_cents")
  discountCents Int @default(0) @map("discount_cents")
  totalCents    Int @map("total_cents")

  promoCodeId String? @map("promo_code_id")

  holdUntil DateTime? @map("hold_until")

  // Payment metadata. With CMI configured these are filled from the gateway
  // callback; in mock mode (no CMI_CLIENT_ID) from payment-sim.ts.
  paymentRef String? @map("payment_ref")
  cardBrand  String? @map("card_brand")
  cardLast4  String? @map("card_last4")
  cardBank   String? @map("card_bank")

  /// The gateway's own transaction id (CMI's `TransId`). Unique so a replayed
  /// callback can never settle a second order against the same payment.
  gatewayRef String? @unique @map("gateway_ref")

  /// How many times the buyer has been sent to the gateway for this order.
  ///
  /// CMI treats its `oid` as ONE transaction: send the same value twice and
  /// the second attempt is refused with "There is an ongoing transaction
  /// related to the order. (99)" — so a buyer whose card was declined could
  /// never retry. The oid is therefore `<orderId>-<attempt>`, and this is the
  /// counter. The callback strips the suffix to find the order again.
  payAttempts Int @default(0) @map("pay_attempts")

  /// Platform commission on this order, in cents, recorded AT SETTLEMENT from
  /// the organiser's plan at that moment — never recomputed. Moving an
  /// organiser to a cheaper plan must not retroactively change what they owed
  /// on tickets already sold. Null for orders settled before plans existed.
  feeCents   Int?    @map("fee_cents")
  /// Which plan produced `feeCents`, kept so a figure can be explained later
  /// even if the plan's rate has since been edited.
  feePlanKey String? @map("fee_plan_key")

  /// Refund audit trail. `refundedCents` accumulates across partial refunds,
  /// so it is the amount already returned — never the amount outstanding.
  refundedCents Int       @default(0) @map("refunded_cents")
  refundedAt    DateTime? @map("refunded_at")
  refundRef     String?   @map("refund_ref")

  /// When the money actually reached the buyer, as opposed to when the refund
  /// was decided.
  ///
  /// These are different events and the gap between them is the whole point.
  /// CMI has no refund API, so `refundedAt` records a decision and somebody
  /// still has to reverse the transaction in the CMI back office by hand.
  /// Without this column there was nothing anywhere to say whether that had
  /// been done: an organiser cancelled an event, every order read REFUNDED,
  /// and no screen could tell a buyer who had their money back from one still
  /// waiting for it.
  ///
  /// Null while a refund is outstanding. Set when an admin marks it sent,
  /// alongside the bank or CMI reference they actioned it with.
  refundPaidAt DateTime? @map("refund_paid_at")
  /// The CMI/bank reference for the reversal, typed in by whoever made it.
  refundPaidRef String?  @map("refund_paid_ref")

  /// How much of this order was paid with store credit rather than a card.
  ///
  /// Kept on the order, not inferred from the ledger, because this is what
  /// makes the money add up: `totalCents` is what the order cost, and the
  /// card was only ever charged `totalCents - creditAppliedCents`. Without
  /// it, settlement could not tell a 300 MAD order paid half in credit from
  /// a 150 MAD order, and the organiser's takings would be overstated by
  /// every dirham of credit ever spent.
  ///
  /// A fully credit-covered order has this equal to totalCents and never
  /// goes to CMI at all.
  creditAppliedCents Int @default(0) @map("credit_applied_cents")

  createdAt DateTime @default(now()) @map("created_at")

  customer    User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promoCode   PromoCode?   @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  lines       OrderLine[]
  tickets     Ticket[]
  /// Credit granted FOR this order (a cancellation) and credit spent ON it
  /// (a checkout). Both, because both point here.
  creditEntries CreditEntry[]
  payoutOrder PayoutOrder?
  /// Set when this order exists to pay for a zone upgrade rather than to
  /// buy seats. Such an order carries a held line but never its own ticket.
  upgrade     TicketUpgrade?

  @@index([customerId])
  @@index([eventId])
  @@index([status, holdUntil]) // the expiry sweep scans PENDING orders by holdUntil
  @@map("orders")
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  tierId  String @map("tier_id")
  qty     Int

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier  TicketTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_lines")
}

/// How a ticket came into being. A comp was never paid for, so it must not
/// appear in revenue, commission or a payout — and the gate still has to
/// admit it exactly like any other.
enum TicketKind {
  /// Bought through checkout.
  SOLD
  /// Issued free by the organiser: press, sponsors, the artist's guest list.
  COMP
}

model Ticket {
  id      String       @id @default(cuid())
  ref     String       @unique // e.g. ET-2026-004815, shown on the e-billet and scanned at the gate
  orderId String       @map("order_id")
  tierId  String       @map("tier_id")
  status  TicketStatus @default(VALID)
  /// SOLD unless an organiser issued it as a comp. Kept on the ticket rather
  /// than inferred from a zero-price order, because a 100%-discounted sale and
  /// a guest-list invitation are different things with different accounting.
  kind    TicketKind   @default(SOLD)

  holderName  String    @map("holder_name")
  seatRow     Int?      @map("seat_row")
  seatNumber  Int?      @map("seat_number")
  usedAt      DateTime? @map("used_at")
  /// Set when a buyer cancels their own ticket, as distinct from an
  /// organiser voiding it — the two need telling apart in a dispute.
  cancelledAt DateTime? @map("cancelled_at")
  /// The ref this ticket replaced, when an organiser reissued a lost one.
  /// Keeps the paper trail without reusing a compromised reference.
  replacesRef String?   @map("replaces_ref")

  /// Credential for a holder who is not the buyer.
  ///
  /// A claimed share puts the replacement ticket on the SENDER's order, so the
  /// recipient can never present that order's token — and they should not be
  /// able to, since it would unlock the sender's other tickets too. This gives
  /// them proof of exactly one ticket. Null for ordinary tickets, which are
  /// reached through their order.
  accessToken String? @unique @map("access_token")

  /// The account this ticket now belongs to, when that is not the buyer.
  ///
  /// A claimed share leaves the replacement ticket on the SENDER's order,
  /// because no money moved and the seat must stay counted exactly once. With
  /// nothing recording the new owner, "my tickets" — which lists every ticket
  /// on your orders — kept showing the sender a live ticket they had given
  /// away, next to the voided one they no longer held.
  ///
  /// Set when a signed-in recipient claims a share. Null for an ordinary
  /// ticket (the buyer owns it) and for a guest claim, which has no account
  /// to point at and is reached through accessToken instead.
  holderId String? @map("holder_id")

  /// This ticket reached its holder through a claimed share.
  ///
  /// Separate from holderId because that column cannot answer the question on
  /// its own: it is null both for "the buyer still holds this" and for "a
  /// guest claimed it", and filtering the buyer's list on `holderId is null`
  /// therefore kept showing them tickets claimed by somebody without an
  /// account. Verified: a guest claim left the sender's count unchanged.
  ///
  /// Always true on a replacement issued by claimShare, whether or not the
  /// claimer was signed in, so "is this still the buyer's?" has one answer.
  gifted Boolean @default(false)

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting an account must not delete a ticket that
  /// was paid for and may still be admitted. It reverts to the buyer's.
  holder     User?          @relation("TicketHolder", fields: [holderId], references: [id], onDelete: SetNull)
  tier       TicketTier     @relation(fields: [tierId], references: [id], onDelete: Restrict)
  resale     ResaleListing?
  shares     TicketShare[]
  upgrades   TicketUpgrade[]
  invitation Invitation?

  @@index([orderId])
  /// The live entry counter aggregates by status; without this it seq-scans
  /// the whole tickets table on every dashboard refresh.
  @@index([status])
  /// tierId is a relation FK with no implicit index in Postgres.
  @@index([tierId])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  kind      PromoKind
  value     Int // percent (0-100) or amount in cents, per `kind`
  eventId   String?   @map("event_id") // null = valid on any event
  maxUses   Int       @map("max_uses")
  uses      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([eventId])
  @@map("promo_codes")
}

// ---------------------------------------------------------------------------
// Waitlist
// ---------------------------------------------------------------------------

/// One email per event, left when a tier is sold out. Organisers read this
/// list from /pro to know demand; nothing is auto-emailed yet (see docs).
/// Someone waiting for a seat on a sold-out event.
///
/// When a seat frees up the next WAITING entry is OFFERED it: the seat is
/// held for them alone until `claimExpiresAt`, reachable through a private
/// `claimToken`. If they don't buy in time the offer lapses and the seat
/// passes to the next person. Without that window an "a seat is free" email
/// is just a race, which is the experience this queue exists to avoid.
model WaitlistEntry {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  status WaitlistStatus @default(WAITING)

  /// Unguessable, single-purpose: it is the only credential a guest needs to
  /// claim their offer, so it is CSPRNG-drawn and cleared once used.
  claimToken     String?   @unique @map("claim_token")
  claimTierId    String?   @map("claim_tier_id")
  claimExpiresAt DateTime? @map("claim_expires_at")
  offeredAt      DateTime? @map("offered_at")
  claimedAt      DateTime? @map("claimed_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, status, createdAt]) // picking the next person in line
  @@index([status, claimExpiresAt]) // expiring stale offers
  @@map("waitlist_entries")
}

enum WaitlistStatus {
  /// In the queue, no seat offered yet.
  WAITING
  /// A seat is held for this person until claimExpiresAt.
  OFFERED
  /// They bought it.
  CLAIMED
  /// Their window lapsed; the seat went to the next person.
  EXPIRED
}

// ---------------------------------------------------------------------------
// Resale
// ---------------------------------------------------------------------------

/// A ticket its owner has put back up for sale.
///
/// Resale is PLATFORM-MEDIATED and at FACE VALUE: the buyer pays Eventick,
/// the seller is refunded what they originally paid, and a fresh ticket is
/// issued to the buyer while the old reference is voided. Nobody hands money
/// to a stranger, and a sold ticket cannot be presented twice.
model ResaleListing {
  id       String       @id @default(cuid())
  ticketId String       @unique @map("ticket_id")
  sellerId String?      @map("seller_id") // null when the original order was a guest checkout
  status   ResaleStatus @default(LISTED)

  /// Face value at listing time, copied so a later tier price change cannot
  /// silently alter what a listed ticket costs.
  priceCents Int @map("price_cents")

  /// Shareable, unguessable listing URL segment.
  token String @unique

  /// The order that bought it, and the ticket issued to that buyer. Both are
  /// set at COMPLETION, so they record a finished sale.
  buyerOrderId String? @map("buyer_order_id")
  newTicketId  String? @map("new_ticket_id")

  /// The order currently attempting to buy this listing, set before the buyer
  /// is sent to the gateway.
  ///
  /// CMI echoes back only our order reference — it has no metadata field to
  /// carry a listing id the way a Stripe PaymentIntent did — so the callback
  /// needs a way to tell "this order bought a resold seat" from "this order
  /// bought fresh inventory". Without it a resale would settle through
  /// settleOrder and issue a ticket against tier stock that was never claimed.
  pendingOrderId String? @unique @map("pending_order_id")

  createdAt DateTime  @default(now()) @map("created_at")
  soldAt    DateTime? @map("sold_at")
  closedAt  DateTime? @map("closed_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  seller User?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("resale_listings")
}

enum ResaleStatus {
  /// On sale.
  LISTED
  /// Bought; the seller has been refunded and a new ticket issued.
  SOLD
  /// Withdrawn by the seller, or voided because the ticket changed state.
  CANCELLED
}

/// A holder paying the difference to move their seat into a dearer zone.
///
/// Mirrors ResaleListing deliberately: both take money through CMI for
/// something that is NOT fresh tier inventory, so both need a row the
/// gateway callback can find from the order reference alone — CMI echoes
/// back nothing else. Without it an upgrade would settle through
/// settleOrder and issue a SECOND ticket instead of moving the first.
///
/// Downgrades never create one of these. They move the seat immediately and
/// refund nothing, so there is no payment to track.
model TicketUpgrade {
  id       String        @id @default(cuid())
  ticketId String        @map("ticket_id")
  buyerId  String?       @map("buyer_id")
  status   UpgradeStatus @default(PENDING)

  /// Where it is going, and what the move costs.
  ///
  /// The price is frozen here at the moment the upgrade is started, for the
  /// same reason ResaleListing freezes face value: the organiser may reprice
  /// a zone while the buyer is away at the gateway, and the amount CMI
  /// authorises must be the amount that was quoted and agreed.
  targetTierId String @map("target_tier_id")
  fromTierId   String @map("from_tier_id")
  dueCents     Int    @map("due_cents")

  /// The order paying for it. Set at creation, before the buyer leaves, and
  /// unique so a replayed callback cannot settle two upgrades against one
  /// payment. It carries an OrderLine for the TARGET tier, which is what
  /// holds the seat while the buyer is on CMI's page.
  orderId String @unique @map("order_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  closedAt    DateTime? @map("closed_at")

  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  buyer      User?      @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  targetTier TicketTier @relation("UpgradeTarget", fields: [targetTierId], references: [id], onDelete: Restrict)
  /// Cascade: the upgrade only exists to describe this payment, so a deleted
  /// order leaves nothing worth keeping.
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ticketId])
  @@map("ticket_upgrades")
}

enum UpgradeStatus {
  /// Payment started; the seat is held by the order's line.
  PENDING
  /// Paid, and the ticket has moved.
  DONE
  /// Abandoned, refused, or the zone filled while the buyer was paying.
  CANCELLED
}

/// A ticket its owner has offered to someone else.
///
/// The recipient opens the link and claims it: a NEW ticket with a fresh QR
/// is issued to them and the sender's is voided. The claim step matters —
/// emailing a ticket blind means one typo sends it to a stranger with no way
/// back, and the sender can revoke an unclaimed share at any time.
model TicketShare {
  id       String      @id @default(cuid())
  ticketId String      @map("ticket_id")
  senderId String?     @map("sender_id") // null for guest orders
  status   ShareStatus @default(OPEN)

  /// Unguessable link segment; cleared once claimed so it cannot be reused.
  token String? @unique

  /// Optional note shown to the recipient, e.g. "see you there".
  message String?

  /// The ticket issued to whoever claimed it.
  newTicketId String? @map("new_ticket_id")
  claimedName String? @map("claimed_name")

  createdAt DateTime  @default(now()) @map("created_at")
  claimedAt DateTime? @map("claimed_at")
  revokedAt DateTime? @map("revoked_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?  @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([status])
  @@map("ticket_shares")
}

enum ShareStatus {
  /// Waiting for the recipient.
  OPEN
  /// Taken; a new ticket exists and the sender's is void.
  CLAIMED
  /// Withdrawn by the sender, or voided because the ticket changed state.
  REVOKED
}

// ---------------------------------------------------------------------------
// Becoming an organiser
//
// Public registration always creates a CUSTOMER (PUBLIC_SIGNUP_ROLE), and
// admins can mint organisers directly — but nothing let someone ASK. The
// "Créer un événement" button in the header was a dead end: logged out it
// bounced to /login, and a logged-in customer was silently redirected to the
// homepage with no explanation.
//
// An application is deliberately a separate row rather than fields on User:
// it survives the decision (a declined applicant keeps their history, and a
// second application is a second row), and the reviewer needs to see who
// asked, when, and what they said — none of which belongs on the account
// itself.
// ---------------------------------------------------------------------------

model OrganiserApplication {
  id     String                     @id @default(cuid())
  userId String                     @map("user_id")
  status OrganiserApplicationStatus @default(PENDING)

  /// Trading name — the artist, venue or company the events run under. Not
  /// the account's own name, which is a person.
  displayName String @map("display_name")
  /// Reachable number. Approving someone to take money is a decision worth
  /// being able to follow up on.
  phone       String
  /// What they intend to put on, in their words.
  pitch       String

  /// Set when an admin decides. Kept even after a decline, so a repeat
  /// application can be read against the earlier one.
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  /// Why it was declined, shown to the applicant.
  decisionNote String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at")

  user       User  @relation("OrganiserApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("OrganiserReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("organiser_applications")
}

enum OrganiserApplicationStatus {
  /// Waiting for an admin to decide.
  PENDING
  /// Approved; the applicant's role was promoted to ORGANISER.
  APPROVED
  /// Turned down. decisionNote says why.
  DECLINED
}

// ---------------------------------------------------------------------------
// Money owed to organisers
//
// Three things used to be fiction here, all of them on the Finance screen: the
// organiser picked their own commission plan from a <select>, the fee was
// computed in the browser and stored nowhere, and "Reversement" named a payout
// that did not exist. These models make the first two real and give the third
// somewhere to live.
//
// The ordering rule throughout: a fee is recorded ON THE ORDER at settlement,
// never recomputed from the plan afterwards. An organiser moved to a cheaper
// plan must not retroactively owe less on tickets already sold, and a payout
// already made must not change value because a rate did.
// ---------------------------------------------------------------------------

/// What the platform charges an organiser. Assigned by an admin — an organiser
/// choosing their own rate is the bug this replaces.
model Plan {
  /// Stable, human-readable key ("starter"), not a cuid: it appears in config
  /// and in the UI, and a re-seed must not orphan the organisers pointing at it.
  key   String @id
  label String

  /// Percentage cut, in BASIS POINTS (500 = 5%). Integer, because a float rate
  /// reintroduces exactly the rounding drift cents exist to avoid.
  rateBps      Int @map("rate_bps")
  /// Fixed monthly fee in cents, on top of the percentage.
  monthlyCents Int @default(0) @map("monthly_cents")

  /// Given to a newly approved organiser when no plan is chosen for them.
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  organisers User[]

  @@map("plans")
}

/// Where a user's money goes. Deliberately minimal: a name and an RIB,
/// which is what a Moroccan bank transfer actually needs.
///
/// Held against ANY user, not only organisers. It started organiser-only,
/// because an organiser payout was the only money the platform ever sent
/// out. Resale broke that: the seller is a customer, their money is held by
/// the platform rather than sitting on a card CMI can reverse, so paying
/// them needs a transfer -- to an account there was no way to record. The
/// admin's "refunds to send" queue showed an amount and a name and no
/// account number, which made "Mark as sent" a button that could not have
/// been telling the truth.
model BankAccount {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// Account holder as the bank has it, which is often the trading name
  /// rather than the person who signed up.
  holderName String  @map("holder_name")
  /// Moroccan RIB: 24 digits. Stored as given, digits only.
  rib        String
  bank       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

enum PayoutStatus {
  /// Calculated, not yet sent to the bank.
  PENDING
  /// Transfer made. `reference` is the bank's.
  PAID
  /// Abandoned — see `note`.
  CANCELLED
}

/// One transfer to one organiser for one period.
///
/// Totals are FROZEN at creation by copying from the orders in the period,
/// rather than recomputed on read: a refund processed next week must not
/// silently change what we already paid out last week.
model Payout {
  id          String       @id @default(cuid())
  organiserId String       @map("organiser_id")
  status      PayoutStatus @default(PENDING)

  /// Half-open period [periodStart, periodEnd), by order settlement time.
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  /// Ticket revenue in the period, already net of refunds.
  grossCents        Int @map("gross_cents")
  /// Platform commission withheld, summed from the orders themselves.
  feeCents          Int @map("fee_cents")
  /// Plan subscription withheld — the fixed monthly part of the plan, charged
  /// once per calendar month the period covers. Zero on Starter, and zero for
  /// a month already billed by an earlier payout.
  subscriptionCents Int @default(0) @map("subscription_cents")
  /// What is actually transferred: gross - fee - subscription. Stored rather
  /// than derived so the row remains readable if any input is corrected.
  netCents          Int @map("net_cents")

  /// Orders included, so a payout can be reconciled line by line.
  orders        PayoutOrder[]
  /// Months this payout billed the subscription for.
  subscriptions SubscriptionCharge[]

  /// Bank's transfer reference, filled when marked PAID.
  reference String?
  note      String?

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  organiser User @relation(fields: [organiserId], references: [id], onDelete: Restrict)

  @@index([organiserId, status])
  @@index([status])
  @@map("payouts")
}

/// Join row pinning one order into one payout.
///
/// `@@unique([orderId])` is the safeguard that matters: an order can appear in
/// at most ONE payout ever, so a second run over an overlapping period cannot
/// pay for the same tickets twice.
model PayoutOrder {
  id       String @id @default(cuid())
  payoutId String @map("payout_id")
  orderId  String @map("order_id")

  /// Copied from the order at the time of the run, for line-by-line
  /// reconciliation without re-reading orders that may since have changed.
  grossCents Int @map("gross_cents")
  feeCents   Int @map("fee_cents")

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId])
  @@index([payoutId])
  @@map("payout_orders")
}

/// One month's plan subscription, billed once.
///
/// The fixed part of a plan ("Pro · 3% + 499/mo") used to be displayed and
/// never charged, which made Pro cheaper than Starter at every volume. It is
/// now withheld from the payout — and this table is what stops it being
/// withheld twice: `@@unique([organiserId, month])` means the database, not a
/// query, guarantees one charge per organiser per month however many payout
/// runs cover it.
model SubscriptionCharge {
  id          String @id @default(cuid())
  organiserId String @map("organiser_id")
  payoutId    String @map("payout_id")

  /// First instant of the billed calendar month, UTC. The month IS the key,
  /// so it is normalised on write rather than stored as given.
  month DateTime

  /// Charged amount, copied from the plan at the time of the run so a later
  /// price change cannot alter a month already billed.
  amountCents Int    @map("amount_cents")
  planKey     String @map("plan_key")

  createdAt DateTime @default(now()) @map("created_at")

  organiser User   @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  payout    Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@unique([organiserId, month])
  @@index([payoutId])
  @@map("subscription_charges")
}

// ---------------------------------------------------------------------------
// Audit trail
//
// Who did what, to whom, and when — for the actions where "it just changed"
// is not an acceptable answer: role changes, permission grants, refunds, plan
// assignments, payouts and account deletion.
//
// Deliberately NOT a general event log. Reads and ordinary CRUD stay out of
// it: a log that records everything is one nobody reads, and the point here is
// that every row is something a person should be able to account for.
// ---------------------------------------------------------------------------

/// A privileged action, recorded.
model AuditEvent {
  id String @id @default(cuid())

  /// Who did it. Nullable because the record must OUTLIVE the account: the
  /// whole reason to log a deletion is to know who performed it, and a
  /// cascade would erase exactly that.
  actorId    String? @map("actor_id")
  /// Actor's email and role AT THE TIME, copied. A renamed or deleted account
  /// would otherwise make an old row unreadable, and a role change after the
  /// fact would silently rewrite the authority the action was taken under.
  actorEmail String  @map("actor_email")
  actorRole  String  @map("actor_role")

  /// What was done: a stable dotted key, e.g. "user.role.changed".
  action String

  /// What it was done to. Free-form id plus a type, rather than a relation to
  /// every auditable model — a foreign key per subject type would make this
  /// table grow a column every time something new becomes auditable, and
  /// would block deleting the subject it describes.
  subjectType  String  @map("subject_type")
  subjectId    String? @map("subject_id")
  /// Human label for the subject, so a row reads without extra lookups and
  /// still reads after the subject is gone.
  subjectLabel String? @map("subject_label")

  /// What changed, as JSON. Shape is per-action and deliberately loose: the
  /// alternative is a column per field, which cannot work across actions as
  /// different as a refund and a permission grant.
  details Json?

  /// Where from. Useful when an account is shared or compromised.
  ip String?

  at DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([action, at])
  @@index([subjectType, subjectId])
  @@index([actorId])
  @@map("audit_events")
}

/// A free ticket the organiser issued to a named guest.
///
/// Its own model rather than a flag on Order, because the questions asked of
/// it are different: who is on the guest list, has it been sent, has it been
/// used. The Ticket it produces is an ordinary ticket with kind COMP, so the
/// gate, the PDF and the QR all work unchanged — the only thing that differs
/// is that no money was involved.
///
/// Deliberately NOT a 100% promo code, which was the only way to do this
/// before: a promo code is a discount on a sale, so it lands in revenue,
/// commission and the payout as a zero-value order and muddles all three.
model Invitation {
  id      String @id @default(cuid())
  eventId String @map("event_id")
  tierId  String @map("tier_id")

  /// Who it is for. Email is optional: a guest list is often just names, and
  /// requiring an address would block the common case.
  guestName  String  @map("guest_name")
  guestEmail String? @map("guest_email")
  /// Free text — "presse", "sponsor", "invité de l'artiste".
  note       String?

  /// The ticket issued for this invitation, once it is issued. Null while the
  /// invitation is only a name on a list.
  ticketId String? @unique @map("ticket_id")

  /// Who issued it, kept for the guest list even after that account is gone.
  issuedById    String?   @map("issued_by_id")
  issuedByEmail String    @map("issued_by_email")
  sentAt        DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  event    Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier     TicketTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  ticket   Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  issuedBy User?      @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([tierId])
  @@map("invitations")
}

/// Where a plan request stands.
enum PlanRequestStatus {
  /// Waiting for an admin to decide.
  PENDING
  /// Granted; the organiser's plan was changed.
  APPROVED
  /// Turned down. decisionNote says why.
  DECLINED
  /// Withdrawn by the organiser before anyone decided.
  CANCELLED
}

/// An organiser asking to move onto a different plan.
///
/// Plans are pure pricing — a lower commission for a fixed monthly fee — and
/// only an admin may assign one, because the alternative is an organiser
/// setting themselves to 2% and never paying the subscription that buys it
/// (it is withheld from payouts, so someone with no payouts would pay
/// nothing). The organiser could see the rates but had no way to act on them:
/// the card said "get in touch" and offered no means of doing so.
///
/// This is that means. It mirrors OrganiserApplication deliberately — same
/// PENDING/APPROVED/DECLINED shape, same reviewer trail — because an admin
/// already reviews those and a second, different-looking queue would be a
/// second thing to learn.
model PlanRequest {
  id     String            @id @default(cuid())
  userId String            @map("user_id")
  status PlanRequestStatus @default(PENDING)

  /// The plan being asked for. A key, not a relation: a plan that is later
  /// retired must not take its history with it.
  planKey     String  @map("plan_key")
  /// What they were on when they asked, so a decision can be read in context
  /// months later even if they have moved since.
  fromPlanKey String? @map("from_plan_key")
  /// Optional: why they want it, in their words.
  note        String?

  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  /// Why it was declined, shown to the organiser.
  decisionNote String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at")

  user       User  @relation("PlanRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PlanReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("plan_requests")
}

// ---------------------------------------------------------------------------
// Store credit
//
// Money the platform owes a buyer, spendable on tickets. Introduced because
// an organiser cancelling an event could only ever promise a bank refund:
// CMI has no refund API, so somebody had to reverse every charge by hand in
// the CMI back office, and until they did, the buyer had been emailed
// "remboursé intégralement" and had nothing. Credit settles instantly and
// needs no bank at all.
//
// WHY A LEDGER AND NOT A BALANCE COLUMN
//
// The obvious design is `User.creditCents Int`, incremented and decremented.
// It was rejected:
//
//   - A single mutable number cannot answer "where did this come from" or
//     "what did I spend it on". That question gets asked the first time a
//     buyer disputes an amount, and a bare total cannot answer it.
//   - Two concurrent checkouts both reading the same balance can both pass a
//     `balance >= total` check and both deduct — spending the same credit
//     twice. Guarding that needs a compare-and-swap on the total, which is
//     exactly the bug refundOrder already had to fix once.
//   - A wrong total is unrecoverable. With entries, the total is derived, so
//     a bad entry is reversed by appending its opposite and the history shows
//     both.
//
// So: append-only rows, balance = SUM(amountCents). Never UPDATE an entry,
// never DELETE one. A mistake is corrected by a new ADJUSTMENT entry.
// ---------------------------------------------------------------------------

/// Why a credit entry exists. Narrow on purpose: a reason that is not one of
/// these is a reason nobody can report on.
enum CreditReason {
  /// An event was cancelled and this buyer's order was converted to credit.
  EVENT_CANCELLED
  /// An organiser or admin refunded one order as credit.
  ORDER_REFUND
  /// Spent at checkout. Negative amount.
  PURCHASE
  /// A credit-paid order was itself cancelled, returning what it consumed.
  PURCHASE_REVERSED
  /// Staff corrected something by hand. Requires a note.
  ADJUSTMENT
}

/// One movement of store credit. Positive = granted, negative = spent.
///
/// Rows are immutable. There is deliberately no `updatedAt`: an entry that
/// can be edited is not a ledger.
model CreditEntry {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// Signed, in cents. Positive grants, negative spends. The sum over a user
  /// IS their balance; nothing else is authoritative.
  amountCents Int          @map("amount_cents")
  reason      CreditReason

  /// The order this entry concerns: the one converted to credit, or the one
  /// the credit was spent on. Null for a staff ADJUSTMENT with no order.
  ///
  /// SetNull, not Cascade: deleting an order must never silently delete the
  /// credit it produced, which would change a buyer's balance to cover up
  /// the deletion.
  orderId String? @map("order_id")

  /// Free text for the holder, shown on their balance screen ("Mawazine
  /// annulé"). Written at grant time, because the event it refers to may be
  /// edited or deleted later.
  label String

  /// Staff-only explanation, required for ADJUSTMENT. Never shown to the
  /// holder.
  note String?

  /// Who caused this, when it was a person. Null for anything the system did
  /// on its own (a cancellation, a checkout spend).
  actorId String? @map("actor_id")

  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation("CreditHolder", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("CreditActor", fields: [actorId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// The balance query: every entry for one holder, newest first.
  @@index([userId, createdAt])
  /// At most ONE grant per order per reason.
  ///
  /// This is the double-grant guard, in the database rather than in a
  /// transaction. cancelEvent refunds order by order and can be retried
  /// after a partial failure; without this, a retry would grant a second
  /// EVENT_CANCELLED entry for an order already converted and double the
  /// buyer's credit. A unique index cannot be defeated by a race.
  ///
  /// PURCHASE is excluded by having its own reason value, so spending credit
  /// on an order you were granted credit for is still possible.
  @@unique([orderId, reason])
  @@map("credit_entries")
}

// ---------------------------------------------------------------------------
// Platform settings
//
// One row, id "platform". A table rather than env vars because these are
// business terms an admin changes from the console, not deploy-time config:
// an env change needs a restart and leaves no record of who changed what.
//
// Deliberately a SINGLETON rather than a key/value store. A key/value table
// makes every read a string parse with no types and no defaults, and the
// first typo is a silent zero. Named columns get the same checking as any
// other model.
// ---------------------------------------------------------------------------

/// Platform-wide settings. Exactly one row, id "platform".
model PlatformSettings {
  /// Fixed id so there can only ever be one row. Not an autoincrement: a
  /// second row would be ambiguous and nothing would say which one won.
  id String @id @default("platform")

  /// The platform's cut of a RESALE, in BASIS POINTS (200 = 2%).
  ///
  /// Integer basis points, exactly like Plan.rateBps, because a float rate
  /// reintroduces the rounding drift that storing money in cents exists to
  /// avoid.
  ///
  /// Taken from the SELLER, not added to the buyer: the price on the listing
  /// is what the buyer pays, and the seller is credited the rest. A buyer
  /// who is quoted 300 and charged 306 at the last step is the surprise this
  /// avoids.
  ///
  /// 0 means no fee, which is the default and the behaviour the product had
  /// before this setting existed.
  ///
  /// NOT the organiser's plan rate. A resale moves an existing seat between
  /// two customers; the organiser was already paid when that seat was first
  /// sold, so charging their plan again bills them for a transaction they
  /// receive nothing from. It used to, and their reported commission rose
  /// after a resale at a rate they were not on.
  resaleFeeBps Int @default(0) @map("resale_fee_bps")

  updatedAt   DateTime @updatedAt @map("updated_at")
  /// Who last changed these terms. Null for the seeded defaults.
  updatedById String?  @map("updated_by_id")

  @@map("platform_settings")
}
