BACKEND_URL="http://localhost:4100"
NEXT_PUBLIC_PLATFORM_NAME="Eventick"

# The site's own public origin. Used for every canonical URL, og:url and
# sitemap entry, so it MUST be the real domain in production — left at the
# localhost default, the sitemap advertises localhost URLs to Google and the
# canonicals point somewhere unreachable.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
